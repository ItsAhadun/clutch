{
  "manifest_version": 3,
  "name": "Clutch",
  "version": "1.1.0",
  "permissions": [
    "cookies",
    "storage",
    "browsingData",
    "scripting",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "limit.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "intro.js",
        "video.js"
      ]
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "keep-playing.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "story.js"
      ],
      "world": "MAIN"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "story",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "commands": {
    "toggle-account": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Switch to the next Instagram account"
    }
  },
  "description": "Switch Instagram accounts with one shortcut, plus video controls, Reels auto-scroll, transcripts, background play and story posting."
}
